YANDEX_FOLDER_ID=replace-with-folder-id
YANDEX_API_KEY=replace-with-api-key
EVIDENCE_MAX_COSINE_DISTANCE=0.78
EVIDENCE_MIN_BM25_SCORE=2.0
LLM_MIN_CONFIDENCE=0.7

# Необязательные параметры для экспериментального подбора retrieval.
# Уберите # у нужной строки; описание влияния и порядок проверки — в README.md.
# CHUNK_SIZE и CHUNK_OVERLAP применяются только к заново загружаемым документам.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# VECTOR_TOP_K=5
# BM25_TOP_K=5
# FUSION_TOP_K=5
# RRF_K=60
# YANDEX_CHAT_MODEL=gpt://folder-id/yandexgpt-5.1
# YANDEX_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=500

# Локальный пароль PostgreSQL для Compose.
# POSTGRES_PASSWORD=local-kb-password
