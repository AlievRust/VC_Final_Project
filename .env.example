YANDEX_FOLDER_ID=replace-with-yandex-folder-id
YANDEX_API_KEY=replace-with-yandex-api-key

# OpenAI-compatible YandexGPT endpoint and model.
YANDEX_OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_CLOUD_MODEL=gpt://replace-with-folder-id/yandexgpt/latest

# Embeddings (can be left at the defaults when using the same folder).
YANDEX_EMBEDDINGS_URL=https://ai.api.cloud.yandex.net/foundationModels/v1/textEmbedding
# YANDEX_DOC_EMBEDDING_MODEL=emb://folder-id/text-search-doc/latest
# YANDEX_QUERY_EMBEDDING_MODEL=emb://folder-id/text-search-query/latest

LOG_LEVEL=INFO
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
